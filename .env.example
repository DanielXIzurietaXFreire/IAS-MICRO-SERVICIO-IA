# Copiar como .env y rellenar. El .env NO se sube nunca a git.

# --- Supabase Storage (evidencia visual) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=pon-aqui-la-service-key
SUPABASE_BUCKET=camaras-imagenes

# --- Backend ASP.NET Core ---
BACKEND_URL=http://localhost:5014
# Usuario propio del microservicio, creado en Supabase Auth.
# OBLIGATORIOS desde el 08/10/2026: POST /api/notificaciones ya exige autenticacion y
# Supabase no tiene politicas para el rol anonimo. Sin esto, el sistema no registra
# ninguna alerta.
BACKEND_EMAIL=
BACKEND_PASSWORD=

# --- Modelo ---
MODELO=models/best.pt
CONFIANZA_MINIMA=0.5

# --- Operacion ---
SEGUNDOS_ENTRE_FOTOGRAMAS=0.2
SEGUNDOS_DE_ESPERA_POR_ALERTA=60
# Cada cuanto se vuelve a pedir la lista de camaras al backend (y se relee zonas.json):
# una camara nueva, retirada o con otro flujo entra en el analisis sin reiniciar.
SEGUNDOS_ENTRE_REVISIONES_DE_CAMARAS=60
HORA_INICIO_LABORAL=08:00
HORA_FIN_LABORAL=18:00
